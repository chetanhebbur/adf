{
	"name": "pl_generic_full_load",
	"properties": {
		"description": "Generic full-snapshot load: copies the entire source file to a date-partitioned landing path.",
		"activities": [
			{
				"name": "SP_LogStart",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [],
				"policy": {
					"timeout": "0.00:10:00",
					"retry": 1,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "etl.usp_log_run_start",
					"storedProcedureParameters": {
						"pipeline_name": {
							"value": {
								"value": "@pipeline().Pipeline",
								"type": "Expression"
							},
							"type": "String"
						},
						"pipeline_run_id": {
							"value": {
								"value": "@pipeline().RunId",
								"type": "Expression"
							},
							"type": "String"
						},
						"source_system": {
							"value": {
								"value": "@pipeline().parameters.p_source_system",
								"type": "Expression"
							},
							"type": "String"
						},
						"load_type": {
							"value": "FULL",
							"type": "String"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "ls_sql_metadata",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "Copy_FullSnapshot",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "SP_LogStart",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.01:00:00",
					"retry": 1,
					"retryIntervalInSeconds": 60,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "DelimitedTextSource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": false,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "DelimitedTextReadSettings"
						}
					},
					"sink": {
						"type": "DelimitedTextSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "DelimitedTextWriteSettings",
							"quoteAllText": false,
							"fileExtension": ".csv"
						}
					},
					"enableStaging": false
				},
				"inputs": [
					{
						"referenceName": "ds_source_csv",
						"type": "DatasetReference",
						"parameters": {
							"p_folder": {
								"value": "@pipeline().parameters.p_source_folder",
								"type": "Expression"
							},
							"p_file": {
								"value": "@pipeline().parameters.p_source_object",
								"type": "Expression"
							}
						}
					}
				],
				"outputs": [
					{
						"referenceName": "ds_landing_csv",
						"type": "DatasetReference",
						"parameters": {
							"p_container": {
								"value": "@pipeline().parameters.p_target_container",
								"type": "Expression"
							},
							"p_folder": {
								"value": "@concat(pipeline().parameters.p_target_path, '/', formatDateTime(utcnow(), 'yyyy/MM/dd'))",
								"type": "Expression"
							},
							"p_file": {
								"value": "@pipeline().parameters.p_source_object",
								"type": "Expression"
							}
						}
					}
				]
			},
			{
				"name": "SP_LogEnd_Success",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [
					{
						"activity": "Copy_FullSnapshot",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.00:10:00",
					"retry": 1,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "etl.usp_log_run_end",
					"storedProcedureParameters": {
						"pipeline_run_id": {
							"value": {
								"value": "@pipeline().RunId",
								"type": "Expression"
							},
							"type": "String"
						},
						"source_system": {
							"value": {
								"value": "@pipeline().parameters.p_source_system",
								"type": "Expression"
							},
							"type": "String"
						},
						"status": {
							"value": "SUCCEEDED",
							"type": "String"
						},
						"rows_copied": {
							"value": {
								"value": "@activity('Copy_FullSnapshot').output.rowsCopied",
								"type": "Expression"
							},
							"type": "Int64"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "ls_sql_metadata",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "SP_LogEnd_Failure",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [
					{
						"activity": "Copy_FullSnapshot",
						"dependencyConditions": [
							"Failed"
						]
					}
				],
				"policy": {
					"timeout": "0.00:10:00",
					"retry": 1,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "etl.usp_log_run_end",
					"storedProcedureParameters": {
						"pipeline_run_id": {
							"value": {
								"value": "@pipeline().RunId",
								"type": "Expression"
							},
							"type": "String"
						},
						"source_system": {
							"value": {
								"value": "@pipeline().parameters.p_source_system",
								"type": "Expression"
							},
							"type": "String"
						},
						"status": {
							"value": "FAILED",
							"type": "String"
						},
						"error_message": {
							"value": {
								"value": "@string(activity('Copy_FullSnapshot').Error.message)",
								"type": "Expression"
							},
							"type": "String"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "ls_sql_metadata",
					"type": "LinkedServiceReference"
				}
			}
		],
		"parameters": {
			"p_source_system": {
				"type": "string"
			},
			"p_source_object": {
				"type": "string"
			},
			"p_source_folder": {
				"type": "string"
			},
			"p_target_container": {
				"type": "string",
				"defaultValue": "landing"
			},
			"p_target_path": {
				"type": "string"
			}
		},
		"annotations": [
			"metadata-driven",
			"full-load"
		]
	}
}