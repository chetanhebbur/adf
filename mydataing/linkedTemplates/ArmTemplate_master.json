{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "mydataing"
		},
		"AmazonS3_pl_secretAccessKey": {
			"type": "secureString",
			"metadata": "Secure string for 'secretAccessKey' of 'AmazonS3_pl'"
		},
		"PostgreSql_ls_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'PostgreSql_ls'"
		},
		"SqlServer_ls_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'SqlServer_ls'"
		},
		"adls_ls_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'adls_ls'"
		},
		"ls_sql_metadata_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'ls_sql_metadata'"
		},
		"AmazonS3_pl_properties_typeProperties_accessKeyId": {
			"type": "string",
			"defaultValue": "AKIAYFH5XOUZJ7YCG4GV"
		},
		"PostgreSql_ls_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "localhost "
		},
		"PostgreSql_ls_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "order"
		},
		"PostgreSql_ls_properties_typeProperties_username": {
			"type": "string",
			"defaultValue": "postgres"
		},
		"SqlServer_ls_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "CHETHAN\\SQLEXPRESS"
		},
		"SqlServer_ls_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "e_commerce"
		},
		"SqlServer_ls_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "SA"
		},
		"adls_ls_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://storageformydata.dfs.core.windows.net/"
		},
		"ls_sql_metadata_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "ibsql-dataeng-ch3.database.windows.net"
		},
		"ls_sql_metadata_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "metadatadb"
		},
		"ls_sql_metadata_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "sqladmin"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "mydataing_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"AmazonS3_pl_secretAccessKey": {
						"value": "[parameters('AmazonS3_pl_secretAccessKey')]"
					},
					"adls_ls_accountKey": {
						"value": "[parameters('adls_ls_accountKey')]"
					},
					"ls_sql_metadata_password": {
						"value": "[parameters('ls_sql_metadata_password')]"
					},
					"PostgreSql_ls_password": {
						"value": "[parameters('PostgreSql_ls_password')]"
					},
					"SqlServer_ls_password": {
						"value": "[parameters('SqlServer_ls_password')]"
					},
					"AmazonS3_pl_properties_typeProperties_accessKeyId": {
						"value": "[parameters('AmazonS3_pl_properties_typeProperties_accessKeyId')]"
					},
					"adls_ls_properties_typeProperties_url": {
						"value": "[parameters('adls_ls_properties_typeProperties_url')]"
					},
					"ls_sql_metadata_properties_typeProperties_server": {
						"value": "[parameters('ls_sql_metadata_properties_typeProperties_server')]"
					},
					"ls_sql_metadata_properties_typeProperties_database": {
						"value": "[parameters('ls_sql_metadata_properties_typeProperties_database')]"
					},
					"ls_sql_metadata_properties_typeProperties_userName": {
						"value": "[parameters('ls_sql_metadata_properties_typeProperties_userName')]"
					},
					"PostgreSql_ls_properties_typeProperties_server": {
						"value": "[parameters('PostgreSql_ls_properties_typeProperties_server')]"
					},
					"PostgreSql_ls_properties_typeProperties_database": {
						"value": "[parameters('PostgreSql_ls_properties_typeProperties_database')]"
					},
					"PostgreSql_ls_properties_typeProperties_username": {
						"value": "[parameters('PostgreSql_ls_properties_typeProperties_username')]"
					},
					"SqlServer_ls_properties_typeProperties_server": {
						"value": "[parameters('SqlServer_ls_properties_typeProperties_server')]"
					},
					"SqlServer_ls_properties_typeProperties_database": {
						"value": "[parameters('SqlServer_ls_properties_typeProperties_database')]"
					},
					"SqlServer_ls_properties_typeProperties_userName": {
						"value": "[parameters('SqlServer_ls_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}